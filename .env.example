# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# In the cluster these come from Kubernetes Secrets, not from a file.

PORT=3000

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=contentcollab

# Redis (Socket.IO adapter)
REDIS_HOST=redis
REDIS_PORT=6379

# DigitalOcean Spaces (S3-compatible), for uploaded files
SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
SPACES_REGION=tor1
SPACES_BUCKET=contentcollab
SPACES_KEY=
SPACES_SECRET=

# Auth
JWT_SECRET=change-me
